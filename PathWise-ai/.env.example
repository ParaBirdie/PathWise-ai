# PathWise AI — Environment Variables
# Copy this to .env.local and fill in your Supabase credentials

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — NEVER prefix with VITE_
ANTHROPIC_API_KEY=sk-ant-...

# Server-side only — used by scripts/enrich-schools.js --upsert to write
# university_profiles (its RLS policy grants public read only). NEVER VITE_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
